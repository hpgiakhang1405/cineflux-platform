ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:7.17.28
DATAHUB_VERSION=v1.5.0.7
DATAHUB_INGESTION_BASE_IMAGE=acryldata/datahub-ingestion:v1.5.0.7
DATAHUB_INGESTION_SLIM_BASE_IMAGE=acryldata/datahub-ingestion:v1.5.0.7-slim
DATAHUB_INGESTION_IMAGE=cineflux/datahub-ingestion:0.1.0
DATAHUB_INGESTION_BASELINE_IMAGE=cineflux/datahub-ingestion:baseline
