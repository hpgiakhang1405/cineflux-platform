SUPERSET_RUNTIME_IMAGE=cineflux/superset:4.1.4
UV_IMAGE=ghcr.io/astral-sh/uv:0.11.26
PYTHON_BASELINE_IMAGE=python:3.14.5-bookworm
PYTHON_RUNTIME_IMAGE=python:3.14.5-slim-bookworm
DBT_PYTHON_RUNTIME_IMAGE=python:3.12.11-slim-bookworm
DATA_GENERATOR_IMAGE=cineflux/data-generator:0.1.0
DATA_GENERATOR_BASELINE_IMAGE=cineflux/data-generator:baseline

# Shared local ports
POSTGRES_PORT=5432
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8081
KAFKA_UI_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
HIVE_METASTORE_PORT=9083
TRINO_PORT=8088
SPARK_MASTER_UI_PORT=8082
SPARK_HISTORY_UI_PORT=18080
FLINK_UI_PORT=8083
AIRFLOW_UI_PORT=8084
ELASTICSEARCH_PORT=9200
DATAHUB_GMS_PORT=8086
DATAHUB_UI_PORT=9002
SUPERSET_UI_PORT=8089
DBT_DOCS_PORT=8085

# Shared endpoints inside Docker Compose
POSTGRES_ENDPOINT=postgres:5432
MINIO_ENDPOINT=http://minio:9000
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
HIVE_METASTORE_URI=thrift://hive-metastore:9083
SPARK_MASTER_URL=spark://spark-master:7077
ICEBERG_CATALOG_NAME=iceberg
CUTOVER_TIMESTAMP=2026-01-01T00:00:00Z
PLAYBACK_AVRO_SCHEMA_PATH=/app/schemas/playback_events_v1.avsc
PLAYBACK_DLQ_AVRO_SCHEMA_PATH=/app/schemas/playback_events_dlq_v1.avsc
PYFLINK_PYTHON_EXECUTABLE=/opt/flink/venv/bin/python
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_INTERNAL_PORT=9200
ELASTICSEARCH_PROTOCOL=http
DATAHUB_GMS_HOST=datahub-gms
DATAHUB_GMS_INTERNAL_PORT=8080
DATAHUB_GMS_PROTOCOL=http
DATAHUB_GMS_URL=http://datahub-gms:8080

# Governance profile memory limits
ELASTICSEARCH_MEMORY_LIMIT=2g
DATAHUB_UPGRADE_MEMORY_LIMIT=1536m
DATAHUB_GMS_MEMORY_LIMIT=2g
DATAHUB_ACTIONS_MEMORY_LIMIT=1g
DATAHUB_FRONTEND_MEMORY_LIMIT=1g

# Spark local resources
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g

# Airflow orchestration runtime
AIRFLOW_BRONZE_SCHEMA=bronze
AIRFLOW_LANDING_SCENARIO=demo
AIRFLOW_LANDING_BOOTSTRAP_PREFIX=bootstrap/initial_historical_playback_events
AIRFLOW_LANDING_RECURRING_PREFIX=recurring
AIRFLOW_SPARK_APPLICATION_PATH=/opt/airflow/jobs/spark_src/spark_jobs/cli.py
AIRFLOW_SPARK_PY_FILES_PATH=/opt/airflow/jobs/spark_jobs.zip
AIRFLOW_SPARK_DP1_CONFIG_PATH=/opt/airflow/jobs/spark_config/spark_dp1_optimized.yaml
AIRFLOW_SPARK_DP2_CONFIG_PATH=/opt/airflow/jobs/spark_config/spark_dp2_optimized.yaml
AIRFLOW_SPARK_COMPACTION_CONFIG_PATH=/opt/airflow/jobs/spark_config/airflow_compaction.yaml
AIRFLOW_SPARK_SNAPSHOT_EXPIRATION_CONFIG_PATH=/opt/airflow/jobs/spark_config/airflow_snapshot_expiration.yaml
AIRFLOW_SPARK_JARS=/opt/airflow/jars/iceberg-spark-runtime.jar,/opt/airflow/jars/hadoop-aws.jar,/opt/airflow/jars/aws-java-sdk-bundle.jar
AIRFLOW_SPARK_DRIVER_HOST=airflow-scheduler
AIRFLOW_SPARK_DRIVER_PYTHON=/usr/local/bin/python
AIRFLOW_SPARK_EXECUTOR_PYTHON=/app/.venv/bin/python
AIRFLOW_SPARK_EVENT_LOG_DIR=file:/opt/spark/events
AIRFLOW_DBT_PROJECT_DIR=/app
AIRFLOW_DBT_PROFILES_DIR=/app/profiles
AIRFLOW_DBT_DP2_SELECTOR=tag:dp2
AIRFLOW_DBT_DP3_SELECTOR=tag:dp3
AIRFLOW_PIPELINE_RETRIES=2
AIRFLOW_PIPELINE_RETRY_DELAY_MINUTES=3
AIRFLOW_ICEBERG_MAINTENANCE_SCHEDULE="0 3 * * 0"
AIRFLOW_OPENLINEAGE_NAMESPACE=cineflux-airflow
AIRFLOW_OPENLINEAGE_TRANSPORT={"type":"http","url":"http://datahub-gms:8080/openapi/openlineage/","endpoint":"api/v1/lineage"}
DOCKER_ENGINE_URL=unix://var/run/docker.sock
DOCKER_NETWORK_NAME=cineflux-network
DOCKER_GID=0

# Flink local resources
FLINK_TASK_SLOTS=6
FLINK_DEFAULT_PARALLELISM=2

# dbt-trino runtime
DBT_TARGET=dev
DBT_TRINO_HOST=trino
DBT_TRINO_PORT=8080
DBT_TRINO_USER=cineflux_dbt
DBT_TRINO_HTTP_SCHEME=http
DBT_THREADS=4
DBT_ICEBERG_CATALOG=iceberg
DBT_POSTGRES_CATALOG=postgresql
DBT_SILVER_SCHEMA=silver
DBT_GOLD_SCHEMA=gold
DBT_FEATURE_SCHEMA=feature

# DataHub governance metadata
DATAHUB_ENV=PROD
DATAHUB_TRINO_PLATFORM_INSTANCE=cineflux-trino
DATAHUB_TRINO_SCHEME=trino
DATAHUB_ICEBERG_PLATFORM_INSTANCE=cineflux-lakehouse
DATAHUB_POSTGRES_PLATFORM_INSTANCE=cineflux-postgres
DATAHUB_KAFKA_PLATFORM_INSTANCE=cineflux-kafka
DATAHUB_OWNER_GROUP=cineflux-data-platform
DATAHUB_DOMAIN_ID=cineflux-data-platform
DATAHUB_DOMAIN_NAME="CineFlux Data Platform"

# PostgreSQL bootstrap
POSTGRES_USER=cineflux
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
CINEFLUX_POSTGRES_DB=cineflux
HIVE_METASTORE_DB=hive_metastore
AIRFLOW_DB=airflow
