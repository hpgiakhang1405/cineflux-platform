# Docker image versions
ALPINE_IMAGE=alpine:3.21.3
POSTGRES_IMAGE=postgres:16.14-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
KAFKA_IMAGE=confluentinc/cp-kafka:7.6.12
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:7.6.12
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
HIVE_IMAGE=apache/hive:4.1.0
HIVE_METASTORE_IMAGE=cineflux/hive-metastore:4.1.0
TRINO_IMAGE=trinodb/trino:483
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu
FLINK_IMAGE=flink:1.20.5-scala_2.12-java17
AIRFLOW_IMAGE=apache/airflow:2.10.5-python3.12
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:7.17.28
DATAHUB_VERSION=v1.5.0.7
SUPERSET_IMAGE=apache/superset:4.1.4
SUPERSET_RUNTIME_IMAGE=cineflux/superset:4.1.4
UV_IMAGE=ghcr.io/astral-sh/uv:0.11.26
PYTHON_BASELINE_IMAGE=python:3.14.5-bookworm
PYTHON_RUNTIME_IMAGE=python:3.14.5-slim-bookworm
DATA_GENERATOR_IMAGE=cineflux/data-generator:0.1.0
DATA_GENERATOR_BASELINE_IMAGE=cineflux/data-generator:baseline

# Shared local ports
POSTGRES_PORT=5432
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8081
KAFKA_UI_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
HIVE_METASTORE_PORT=9083
TRINO_PORT=8088
SPARK_MASTER_UI_PORT=8082
SPARK_HISTORY_UI_PORT=18080
FLINK_UI_PORT=8083
AIRFLOW_UI_PORT=8084
ELASTICSEARCH_PORT=9200
DATAHUB_GMS_PORT=8086
DATAHUB_UI_PORT=9002
SUPERSET_UI_PORT=8089

# Shared endpoints inside Docker Compose
POSTGRES_ENDPOINT=postgres:5432
MINIO_ENDPOINT=http://minio:9000
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
HIVE_METASTORE_URI=thrift://hive-metastore:9083
PLAYBACK_AVRO_SCHEMA_PATH=/app/schemas/playback_events_v1.avsc
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_INTERNAL_PORT=9200
ELASTICSEARCH_PROTOCOL=http
DATAHUB_GMS_HOST=datahub-gms
DATAHUB_GMS_INTERNAL_PORT=8080
DATAHUB_GMS_PROTOCOL=http

# Governance profile memory limits
ELASTICSEARCH_MEMORY_LIMIT=2g
DATAHUB_UPGRADE_MEMORY_LIMIT=1536m
DATAHUB_GMS_MEMORY_LIMIT=2g
DATAHUB_ACTIONS_MEMORY_LIMIT=1g
DATAHUB_FRONTEND_MEMORY_LIMIT=1g

# PostgreSQL bootstrap
POSTGRES_USER=cineflux
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
CINEFLUX_POSTGRES_DB=cineflux
HIVE_METASTORE_DB=hive_metastore
AIRFLOW_DB=airflow
SUPERSET_DB=superset
DATAHUB_DB=datahub
POSTGRES_SERVING_SCHEMA=serving
POSTGRES_STREAMING_SCHEMA=streaming

# MinIO bootstrap
MINIO_ROOT_USER=cineflux
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_REGION=us-east-1
MINIO_LANDING_BUCKET=cineflux-landing
MINIO_WAREHOUSE_BUCKET=cineflux-warehouse
MINIO_CHECKPOINT_BUCKET=cineflux-checkpoints

# Kafka KRaft
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Airflow local administrator
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_PASSWORD
AIRFLOW_ADMIN_FIRSTNAME=CineFlux
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_FERNET_KEY=CHANGE_ME_AIRFLOW_FERNET_KEY
AIRFLOW_SECRET_KEY=CHANGE_ME_AIRFLOW_SECRET_KEY

# Superset local administrator
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=CHANGE_ME_SUPERSET_PASSWORD
SUPERSET_ADMIN_FIRSTNAME=CineFlux
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@example.invalid
SUPERSET_SECRET_KEY=CHANGE_ME_SUPERSET_SECRET_KEY

# DataHub internal signing material
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=CHANGE_ME_DATAHUB_SIGNING_KEY
DATAHUB_TOKEN_SERVICE_SALT=CHANGE_ME_DATAHUB_SALT
DATAHUB_SYSTEM_CLIENT_SECRET=CHANGE_ME_DATAHUB_SYSTEM_SECRET
DATAHUB_FRONTEND_SECRET=CHANGE_ME_DATAHUB_FRONTEND_SECRET
