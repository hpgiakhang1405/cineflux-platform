AIRFLOW_VERSION=2.10.5
AIRFLOW_PYTHON_VERSION=3.10
AIRFLOW_BASE_IMAGE=apache/airflow:2.10.5-python3.10
AIRFLOW_IMAGE=cineflux/airflow:0.1.0
